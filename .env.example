# =============================================
# VeriTruth — Environment Variables Example
# =============================================
# Copy this file to .env and fill in the values.
# Never commit your actual .env file to version control.

# --- Database ---
DATABASE_URL=mysql://user:password@localhost:3306/veritruth

# --- Authentication ---
JWT_SECRET=your-super-secret-jwt-key-here

# --- Manus OAuth (if using Manus platform) ---
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# --- AI APIs ---
# OpenAI API Key (for GPT-4 based agents)
OPENAI_API_KEY=sk-...

# Google Gemini API Key (for Gemini based agents)
GEMINI_API_KEY=AIza...

# --- Built-in Forge API (Manus platform) ---
BUILT_IN_FORGE_API_URL=https://api.manus.im/forge
BUILT_IN_FORGE_API_KEY=your-forge-api-key
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im/forge

# --- App Config ---
VITE_APP_TITLE=VeriTruth
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=Your Name
